# NANDA Registry — production environment
# cp .env.prod.example .env.prod  — then fill in every blank value
# Generate strong secrets: openssl rand -hex 64

# ── Host ──────────────────────────────────────────────────────────────────────
# Your domain (e.g. registry.example.com) or bare IP with http:// prefix
# Domain example: HOST=registry.example.com
# IP example:     HOST=http://1.2.3.4
HOST=

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── Server ────────────────────────────────────────────────────────────────────
# Must be at least 32 chars in production
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Shared ────────────────────────────────────────────────────────────────────
DB_MAX_CONNECTIONS=10

# ── Web (baked into the Next.js bundle at build time) ─────────────────────────
# Must match HOST above — use https:// for domains, http:// for bare IPs
# Domain example: NEXT_PUBLIC_REGISTRY_API_URL=https://registry.example.com/api
# IP example:     NEXT_PUBLIC_REGISTRY_API_URL=http://1.2.3.4/api
NEXT_PUBLIC_REGISTRY_API_URL=
