# NANDA Registry — production environment
# cp .env.prod.example .env.prod  — then fill in every blank value
# Generate strong secrets: openssl rand -hex 64

# ── Host ──────────────────────────────────────────────────────────────────────
# Domain (gets free HTTPS automatically):
#   HOST=registry.example.com
# Bare IP (HTTP only — no https:// prefix, no trailing slash):
#   HOST=http://157.230.91.173
HOST=

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── Server ────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Shared ────────────────────────────────────────────────────────────────────
DB_MAX_CONNECTIONS=10

# ── Web (baked into the Next.js bundle at build time) ─────────────────────────
# Must match HOST above:
#   Domain: NEXT_PUBLIC_REGISTRY_API_URL=https://registry.example.com/api
#   Bare IP: NEXT_PUBLIC_REGISTRY_API_URL=http://157.230.91.173/api
NEXT_PUBLIC_REGISTRY_API_URL=
