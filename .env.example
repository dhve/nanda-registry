# NANDA Registry — environment variables
# Copy to .env and fill in values before running docker compose up

# ── Required ──────────────────────────────────────────────────────────────────
# Admin token for write access to the registry API
REGISTRY_ADMIN_TOKEN=change-this-to-a-strong-secret

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=registry-local

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=registry-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# ── Misc ──────────────────────────────────────────────────────────────────────
DB_MAX_CONNECTIONS=10
